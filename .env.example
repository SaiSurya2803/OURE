# OU RESULTS INTELLIGENCE — Environment Variables

# Frontend Environment Variables (Vercel)
# The public or internal URL where the FastAPI backend is hosted:
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend Environment Variables (Railway / Render / Docker / Supabase)
# SQLite by default, or PostgreSQL connection string:
DATABASE_URL=sqlite:///./ou_results.db
# DATABASE_URL=postgresql://user:password@host:5432/database

# Backend Server Host & Port
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=*

# Google Gemini AI Integration (Optional)
# Leave blank to use the built-in Academic Intelligence Heuristic Engine (zero setup required).
# Or get a 100% free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

